#!/usr/bin/env bash
# claude falso para os testes: devolve uma proposta fixa e conta o que recebeu.
prompt=""
ferramentas=""
proibidas=""
while [ $# -gt 0 ]; do
  case "$1" in
    -p) prompt="$2"; shift 2 ;;
    --allowedTools) ferramentas="$2"; shift 2 ;;
    --disallowedTools) proibidas="$2"; shift 2 ;;
    *) shift ;;
  esac
done
[ -n "$CLAUDE_FALSO_FALHA" ] && { printf '{"result":"limite de uso atingido","is_error":true}\n'; exit 1; }
sleep "${CLAUDE_FALSO_ESPERA:-0}"
obs="Ferramentas: $ferramentas; proibidas: $proibidas."
case "$prompt" in *"REGRA EDITADA"*) obs="$obs Seguiu a instrução editada." ;; esac
case "$prompt" in *"Ele já tem estes cartões"*) obs="$obs Recebeu os cartões existentes." ;; esac
case "$prompt" in *"PEDIDO EDITADO"*) obs="$obs Recebeu o pedido editado." ;; esac
case "$prompt" in *"Escolha as 3 mais didáticas"*)
  printf '{"type":"result","result":"","is_error":false,"structured_output":{"escolhidas":[5,2,99,2,6],"motivo":"Uma de cada situação. %s"}}\n' "$obs"; exit 0 ;; esac
entrada=$(cat)
case "$prompt" in *"Tire até 3 frases de exemplo"*)
  case "$entrada" in *"[áudio 1]"*) [[ "$entrada" != *"Menu do site"* && "$entrada" != *"não é texto"* ]] && obs="$obs Recebeu o texto da página." ;; esac
  printf '{"type":"result","result":"","is_error":false,"structured_output":{"exemplos":[{"ingles":"**He told a joke to break the ice.**","traducao":"Ele contou uma piada para quebrar o gelo.","audio":1},{"ingles":"Let us break the ice.","traducao":"Vamos quebrar o gelo.","audio":7},{"ingles":"","traducao":"vazia","audio":0}],"motivo":"%s"}}\n' "$obs"; exit 0 ;; esac
case "$entrada" in *"<texto>"*"TEXTO DO ACERVO"*"</texto>"*) obs="$obs Recebeu o texto pela entrada." ;; esac
case "$prompt" in *"Capítulos do texto (para o campo secao): \"Governo Lula\""*) obs="$obs Recebeu os capítulos." ;; esac
case "$prompt" in *"gerar-do-texto"*|*"cartões de um texto do Acervo"*) obs="$obs Seguiu a instrução do texto." ;; esac
printf '{"type":"result","result":"","is_error":false,"structured_output":{"nome_baralho":"Presidentes do Brasil no século 21","observacoes":"%s","cartoes":[{"frente":"Quem foi presidente do Brasil de 2003 a 2010?","verso":"Luiz Inácio Lula da Silva","tags":"presidentes","imagem":"Luiz Inácio Lula da Silva","secao":"## governo lula"},{"frente":"Quem sucedeu Lula em 2011?","verso":"Dilma Rousseff","tags":"presidentes","imagem":""},{"frente":"  ","verso":"cartão vazio, deve sumir","tags":"","imagem":""}]}}\n' "$obs"
